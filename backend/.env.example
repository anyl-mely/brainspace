# Template only. Copy to .env locally; fill real values outside Git.
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# Use an isolated development database. No real credentials here.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
SESSION_TTL_DAYS=7

# Choose one AI provider/model after technical spike.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
AI_DAILY_REQUEST_LIMIT=20
AI_TIMEOUT_MS=30000

# Private storage. Adapt variable names to chosen provider.
STORAGE_URL=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=100
